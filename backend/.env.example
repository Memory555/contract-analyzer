APP_VERSION=v6.0.0

# OpenAI or OpenAI-compatible model service
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Optional: set a token to protect /admin and admin APIs.
# Leave empty for local-only development.
BACKEND_ADMIN_TOKEN=
RUNTIME_CONFIG_PATH=backend/data/model-config.json

# Upload and batch limits
MAX_UPLOAD_MB=20
MAX_BATCH_FILES=20

# OCR for scanned PDF / JPG / PNG
ENABLE_OCR=true
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_OCR_REGION=ap-guangzhou

# DOC conversion
ENABLE_DOC_CONVERT=true
# Optional when libreoffice/soffice is not in PATH.
LIBREOFFICE_PATH=
