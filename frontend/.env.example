# v6 frontend only calls the backend service for parsing and LLM analysis.
NEXT_PUBLIC_BACKEND_API_BASE_URL=http://localhost:8000

# Optional: PostgreSQL feedback storage for /api/feedback.
# Prefer DATABASE_URL when available.
DATABASE_URL=

# Optional split-field PostgreSQL configuration.
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=postgres
PG_SSL=true
PG_SSL_REJECT_UNAUTHORIZED=true
