OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
NEXT_PUBLIC_DEMO_MODE=true

# ---- PostgreSQL feedback storage ----
# Neon recommended: copy the pooled connection string from Project Dashboard -> Connect.
# Example: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
DATABASE_URL=

# Optional split-field configuration for non-DATABASE_URL deployments.
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=postgres
PG_SSL=true
